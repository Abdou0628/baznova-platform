// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  password         String?
  image            String?
  plan             String   @default("free") // free | starter | pro | career_plus | employer | enterprise | annual | api
  role             String   @default("candidate") // candidate | employer
  companyName      String?
  industry         String?
  companyWebsite   String?
  cvCountThisMonth Int      @default(0)
  clCountThisMonth Int      @default(0)
  lastResetMonth   Int      @default(0)
  lsCustomerId     String?
  lsVariantId      String?
  lsSubId          String?
  paymobOrderId    String?
  paymobPaymentId  String?
  paymobProvider   String?
  stripeCustomerId String?
  resetCode        String?
  resetCodeExpires DateTime?
  emailVerified          Boolean   @default(false)
  verificationToken      String?
  verificationTokenExpires DateTime?
  sessionVersion   Int      @default(0)
  planExpiresAt    DateTime?
  gracePeriodUntil DateTime?
  mfaEnabled       Boolean  @default(false)
  mfaSecret        String?  // TOTP secret (encrypted at rest in production)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  referralCode       String?  @unique
  referralsMade      Referral[]  @relation("ReferrerReferrals")
  referralReceived   Referral?  @relation("ReferredReferral")
  emailLogs          EmailLog[]  @relation("EmailLogs")

  resumes      Resume[]
  coverLetters CoverLetter[]
  satisfactionRatings SatisfactionRating[]
  supportTickets      SupportTicket[]
  jobListings         JobListing[]
  applications        Application[]
  globalJobListings   GlobalJobListing[]  @relation("GlobalEmployer")
  globalApplications  GlobalApplication[]
  mobilityProfiles    MobilityProfile[]
  interviewSessions   InterviewSession[]
  linkedinAnalyses   LinkedInAnalysis[]
  recruiterJobs      RecruiterJob[]
  careerAssessments   CareerAssessment[]
  coachSessions       CoachSession[]
  coachGoals          CoachGoal[]
  enrollments         Enrollment[]
  certifications      Certification[]
  freelanceMissions  FreelanceMission[] @relation("FreelanceClient")
  freelanceProposals FreelanceProposal[]
  campusStudents      CampusStudent[]
  communityPosts      CommunityPost[]
  communityReplies    CommunityReply[]
  communityProfile    CommunityProfile?
  whiteLabelTenants   WhiteLabelTenant[]
  legalDocuments      LegalDocument[]
  complianceChecks    ComplianceCheck[]
  userConsents         UserConsent[]
  jobNotifications     JobNotification[]
  payments            Payment[]     @relation("UserPayments")
  paymentMethods      PaymentMethod[] @relation("UserPaymentMethods")
  invoices            Invoice[]    @relation("UserInvoices")
  missions           AgentMission[] @relation("UserMissions")
  betaFeedbacks      BetaFeedback[]
}

// ===== HireNova Formation — Training & Certification =====

model FormationCourse {
  id          String     @id @default(cuid())
  title       String
  description String
  category    String     @default("general") // tech, marketing, finance, design, soft-skills, languages
  level       String     @default("beginner") // beginner, intermediate, advanced
  duration    Int        @default(0) // hours
  language    String     @default("fr")
  modules     String     // JSON array of {title, type, content}
  rating      Float      @default(0)
  enrollCount Int        @default(0)
  featured    Boolean    @default(false)
  createdAt   DateTime   @default(now())

  enrollments Enrollment[]
}

model Enrollment {
  id          String          @id @default(cuid())
  userId      String?
  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  courseId    String
  course      FormationCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    Int             @default(0) // 0-100
  completed   Boolean         @default(false)
  startedAt   DateTime        @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([courseId])
}

model Certification {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  courseId    String
  courseTitle String
  score       Int      // exam score 0-100
  certId      String   @unique // unique certificate number
  issuedAt    DateTime @default(now())

  @@index([userId])
  @@index([certId])
}

model SatisfactionRating {
  id        String   @id @default(cuid())
  userId    String?
  type      String   // cv | cover_letter
  itemId    String?
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("open") // open | resolved | closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Resume {
  id               String   @id @default(cuid())
  userId           String?
  fullName         String
  email            String
  phone            String?
  location         String?
  linkedin         String?
  website          String?
  targetJob        String
  industry         String?
  language         String   @default("fr")
  experience       String?
  education        String?
  skills           String?
  languages        String?
  summary          String?
  softSkills       String?
  dateOfBirth      String?
  birthPlace       String?
  birthCountry     String?
  templateStyle    String   @default("modern")
  generatedContent String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SecurityLog {
  id        String   @id @default(cuid())
  type      String   // rate_limit | brute_force | suspicious_input | sql_injection_attempt | xss_attempt | invalid_auth | forbidden_access
  severity  String   // low | medium | high | critical
  ip        String
  path      String
  method    String
  userAgent String?
  email     String?
  details   String?
  createdAt DateTime @default(now())
}

model CoverLetter {
  id               String   @id @default(cuid())
  userId           String?
  fullName         String
  email            String
  phone            String?
  location         String?
  companyName      String
  hiringManager    String?
  jobTitle         String
  jobReference     String?
  whyCompany       String?
  keyStrengths     String?
  tone             String   @default("semi-formal")
  additionalNotes  String?
  language         String   @default("fr")
  generatedContent String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model JobListing {
  id               String   @id @default(cuid())
  employerId       String?
  title            String
  company          String
  location         String
  country          String   @default("Maroc")
  type             String   @default("CDI")
  salaryMin        Int?
  salaryMax        Int?
  currency         String   @default("MAD")
  description      String
  requirements      String
  skills           String?
  language         String   @default("fr")
  isRemote         Boolean  @default(false)
  isPaid           Boolean  @default(false)
  status           String   @default("active")
  viewsCount       Int      @default(0)
  applicationsCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employer         User?       @relation(fields: [employerId], references: [id], onDelete: Cascade)
  applications     Application[]
}

model Application {
  id            String   @id @default(cuid())
  jobId         String
  candidateId   String?
  candidateName String
  candidateEmail String
  coverNote     String?
  matchScore    Int?
  matchAnalysis String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  job           JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     User?      @relation(fields: [candidateId], references: [id], onDelete: SetNull)
}

model ApiSubscriber {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  company         String
  website         String?
  industry        String?
  phone           String?
  apiKey          String   @unique
  apiSecretHash   String
  plan            String   @default("starter")
  status          String   @default("active")
  creditsUsed     Int      @default(0)
  creditsLimit    Int      @default(100)
  lastResetDate   String   @default("")
  webhookUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  usageLogs       ApiUsageLog[]
}

model ApiUsageLog {
  id            String   @id @default(cuid())
  subscriberId  String
  endpoint      String
  credits       Int      @default(1)
  status        String   @default("success")
  errorMessage  String?
  ip            String?
  createdAt     DateTime @default(now())
  subscriber    ApiSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
}

// ===== HireNova Global — International Recruitment =====

model GlobalJobListing {
  id               String   @id @default(cuid())
  employerId       String?
  title            String
  company          String
  location         String
  country          String
  region           String   // Europe, Asia, Africa, Americas, MENA
  type             String   @default("CDI")
  salaryMin        Int?
  salaryMax        Int?
  currency         String   @default("EUR")
  description      String
  requirements      String
  skills           String?
  language         String   @default("en")
  visaSponsorship  Boolean  @default(false)
  relocationPackage Boolean  @default(false)
  isRemote         Boolean  @default(false)
  status           String   @default("active")
  viewsCount       Int      @default(0)
  applicationsCount Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  employer         User?       @relation("GlobalEmployer", fields: [employerId], references: [id], onDelete: Cascade)
  applications     GlobalApplication[]
}

model GlobalApplication {
  id            String   @id @default(cuid())
  jobId         String
  candidateId   String?
  candidateName String
  candidateEmail String
  coverNote     String?
  matchScore    Int?
  matchAnalysis String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  job           GlobalJobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     User?           @relation(fields: [candidateId], references: [id], onDelete: SetNull)
}

// ===== HireNova Mobilité — Country-specific CV/CL formatting =====

model MobilityProfile {
  id              String   @id @default(cuid())
  userId          String?
  fullName        String
  email           String
  originCountry   String
  targetCountry   String
  targetRole      String
  extractedText   String   // OCR raw text
  structuredData  String   // JSON: parsed profile
  skills          String   // JSON: normalized skills array
  matchScore      Int?
  formattedCV     String?  // country-specific CV content
  formattedCL     String?  // country-specific CL content
  status          String   @default("draft") // draft | processing | completed | error
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ===== HireNova LinkedIn — Profile Optimizer =====

model LinkedInAnalysis {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profileText String
  analysis    String   // JSON string with analysis results
  score       Int      // 0-100
  language    String   @default("fr")
  createdAt   DateTime @default(now())
}

// ===== HireNova Referral — Programme Parrainage =====

model Referral {
  id             String   @id @default(cuid())
  referrerId     String
  referralCode   String
  referredEmail  String
  referredUserId String? @unique
  status         String   @default("PENDING") // PENDING | COMPLETED | REWARDED
  rewardType     String   @default("FREE_MONTH") // FREE_MONTH | DISCOUNT
  rewardValue    String   @default("1")
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  referrer User @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User? @relation("ReferredReferral", fields: [referredUserId], references: [id])

  @@unique([referrerId, referredEmail])
}

// ===== Enterprise Inquiries — Demandes de devis sur mesure =====

model EnterpriseInquiry {
  id              String   @id @default(cuid())
  // Contact
  contactName     String
  workEmail       String
  phone           String?
  // Company
  companyName     String
  jobTitle        String?
  industry        String?
  companySize     String?  // 1-10 | 11-50 | 51-200 | 201-1000 | 1000+
  country         String?
  website         String?
  // Needs
  usersCount      String?  // number of expected users
  useCase         String?  // CV generation | ATS | Recruiting | API | All
  message         String
  budget          String?  // <5k | 5k-20k | 20k-50k | 50k+ | unknown
  status          String   @default("new") // new | contacted | qualified | won | lost
  source          String   @default("pricing_page")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ===== Documents — Auto-generated PDF documents (invoices, quotes, agreements, receipts) =====

model Document {
  id            String   @id @default(cuid())
  type          String   // invoice | quote | agreement | receipt | credit_note | accounting_statement
  number        String   @unique // human-readable: FAC-2026-001, DEV-2026-001, BIL-2026-001, etc.
  // Parties
  recipientName String
  recipientEmail String
  recipientCompany String?
  recipientAddress String?
  recipientCountry String?
  // Billing
  issuerName    String   @default("HireNova")
  issuerLegal   String   @default("E-Society 2050")
  issuerAddress String   @default("Casablanca, Maroc")
  issuerEmail   String   @default("hello@hirenova.com")
  issuerVAT     String?  @default("Non assujetti TVA — auto-entrepreneur")
  // Content
  subject       String
  items         String   // JSON array: [{ description, quantity, unitPrice, total }]
  currency      String   @default("EUR")
  subtotal      Float
  taxRate       Float    @default(0)
  taxAmount     Float    @default(0)
  total         Float
  // Status
  status        String   @default("draft") // draft | sent | paid | accepted | rejected | cancelled | expired
  issueDate     DateTime @default(now())
  dueDate       DateTime?
  paidAt        DateTime?
  // Relations
  userId        String?
  inquiryId     String?  // links to EnterpriseInquiry
  // ===== Electronic signature (all documents) =====
  signatureHash   String?  // SHA-256 hash of document fingerprint
  signatureDate   DateTime? // when the signature was applied
  signedBy        String?  @default("HireNova — E-Society 2050")
  signatureSerial String?  // unique signature serial: SIG-YYYY-NNNNNN
  // ===== Accounting statement (bilan) specific =====
  periodStart   DateTime? // period covered start
  periodEnd     DateTime? // period covered end
  linkedDocIds  String?  // JSON array of source invoice IDs aggregated in this bilan
  invoiceCount  Int      @default(0) // number of invoices aggregated
  platformFees  Float    @default(0) // payment processing + infra fees
  royaltyFees   Float    @default(0) // third-party royalties/redevances
  netProfit     Float    @default(0) // total - platformFees - royaltyFees
  totalCollected Float   @default(0) // total TTC encaissé
  // Storage
  pdfPath       String?  // stored on disk or in DB
  pdfBase64     String?  // base64-encoded PDF (for small docs)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([number])
  @@index([createdAt])
  @@index([paidAt])
}

// ===== Email Onboarding — Suivi des emails envoyés =====

model EmailLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  template  String   // welcome | firstCV | atsTips | ecosystem | proOffer | custom
  step      String   @default("onboarding") // onboarding | referral | campus | transactional
  subject   String
  status    String   @default("sent") // sent | failed | bounced
  error     String?
  sentAt    DateTime @default(now())

  user      User?    @relation("EmailLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([template])
}

// ===== HireNova Payment Orchestrator — Provider Registry =====

model PaymentProvider {
  id                 String   @id @default(cuid())
  name               String   @unique // stripe | paymob | lemonsqueezy | payzone | naps | cmi
  displayName        String   @default("")
  country            String   @default("") // MA, FR, EU, US, INTL
  currencies         String   @default("[]") // JSON array: ["MAD", "EUR", "USD"]
  paymentMethods     String   @default("[]") // JSON array: ["card", "mobile", "bank_transfer"]
  supportsRecurring   Boolean  @default(false)
  supportsRefund     Boolean  @default(false)
  supportsTokenization Boolean @default(false)
  supportsWebhooks   Boolean  @default(false)
  priority           Int      @default(0) // lower = higher priority
  enabled            Boolean  @default(true)
  config             String   @default("{}") // JSON: provider-specific config (API keys stored in env, not here)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  payments           Payment[]

  @@index([enabled])
  @@index([country])
  @@index([priority])
}

// ===== HireNova Payment — Immutable Financial Ledger =====

model Payment {
  id                   String   @id @default(cuid())
  userId               String?
  user                 User?    @relation("UserPayments", fields: [userId], references: [id], onDelete: SetNull)
  subscriptionId       String?
  methodId             String?  // FK to PaymentMethod (optional)
  provider             String   // stripe | paymob | lemonsqueezy | payzone | naps | cmi
  providerPaymentId    String?  // external ID from the payment provider
  amount               Int      // stored in cents (smallest currency unit)
  currency             String   @default("EUR")
  status               String   @default("created") // created | pending | authorized | captured | succeeded | failed | cancelled | expired | refunded | partially_refunded
  description          String   @default("")
  metadata             String?  // JSON: additional context
  idempotencyKey       String   @unique
  expiresAt            DateTime?
  capturedAt           DateTime?
  refundedAt           DateTime?
  refundedAmount       Int      @default(0) // in cents
  providerData         String?  // JSON: raw response from provider
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  events               PaymentEvent[]
  invoice              Invoice?
  method               PaymentMethod? @relation(fields: [methodId], references: [id])
  providerConfig       PaymentProvider? @relation(fields: [provider], references: [name])

  @@index([userId])
  @@index([provider])
  @@index([status])
  @@index([idempotencyKey])
  @@index([providerPaymentId])
  @@index([createdAt])
}

// ===== Payment Events — Immutable State Machine Log =====

model PaymentEvent {
  id          String   @id @default(cuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType   String   // payment_created | payment_pending | payment_authorized | payment_captured | payment_succeeded | payment_failed | payment_refunded | payment_cancelled | payment_expired | payment_partially_refunded
  statusFrom  String?  // previous status
  statusTo    String   // new status
  providerEventId String? // event_id from webhook for idempotency
  data        String?  // JSON: event payload
  createdAt   DateTime @default(now())

  @@index([paymentId])
  @@index([eventType])
  @@index([providerEventId])
  @@index([createdAt])
}

// ===== Payment Methods — Tokenized Cards/Wallets =====

model PaymentMethod {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("UserPaymentMethods", fields: [userId], references: [id], onDelete: Cascade)
  provider         String   // stripe | paymob | payzone | naps | cmi
  providerTokenId  String?  // token from the provider (NEVER store full card number)
  type             String   @default("card") // card | mobile | bank_transfer | wallet
  last4            String?  // last 4 digits only
  brand            String?  // visa, mastercard, etc.
  expMonth         Int?
  expYear          Int?
  isDefault        Boolean  @default(false)
  enabled          Boolean  @default(true)
  metadata         String?  // JSON: additional non-sensitive data
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  payments         Payment[]

  @@index([userId])
  @@index([provider])
  @@index([isDefault])
}

// ===== Invoice — Billing Records =====

model Invoice {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation("UserInvoices", fields: [userId], references: [id], onDelete: SetNull)
  paymentId       String?  @unique
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoiceNumber   String   @unique
  amount          Int      // in cents
  currency        String   @default("EUR")
  status          String   @default("draft") // draft | pending | paid | failed | refunded | cancelled
  description     String   @default("")
  lineItems       String   @default("[]") // JSON: [{description, amount, quantity}]
  dueDate         DateTime?
  paidAt          DateTime?
  metadata        String?  // JSON
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ===== Accounting Entries — Financial tracking for all payments =====

model AccountingEntry {
  id          String   @id @default(cuid())
  type        String   // income | expense | refund | platform_fee | royalty
  category    String   // subscription | enterprise | api_usage | infra | tax | payout
  description String
  amount      Float
  currency    String   @default("MAD")
  status      String   @default("pending") // pending | confirmed | reconciled
  userId      String?
  reference   String?  // external payment reference (PayMob tx ID, Stripe charge ID, etc.)
  metadata    String?  // JSON: additional details
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([category])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

// ===== HireNova Interview Simulator — AI Interview Practice =====

model InterviewSession {
  id            String   @id @default(cuid())
  userId        String?
  jobTitle      String
  industry      String
  language      String   @default("fr")
  difficulty    String   @default("intermediate") // beginner | intermediate | advanced
  interviewType String   @default("behavioral") // behavioral | technical | mixed
  status        String   @default("in_progress") // in_progress | completed
  totalScore    Float?
  report        String?  // JSON: overall evaluation
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      InterviewMessage[]
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model InterviewMessage {
  id            String   @id @default(cuid())
  sessionId     String
  questionIndex Int
  question      String
  userAnswer    String?
  aiScore       Float?
  aiFeedback    String?
  aiTips        String?
  followUp      String?
  createdAt     DateTime @default(now())

  session       InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ===== HireNova Recruiter — AI Recruitment Pipeline =====

model RecruiterJob {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  department  String   @default("")
  location    String   @default("")
  type        String   @default("full-time") // full-time, part-time, contract, internship
  salaryMin   Int?
  salaryMax   Int?
  status      String   @default("open") // open, paused, closed, filled
  candidates  RecruiterCandidate[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model RecruiterCandidate {
  id          String   @id @default(cuid())
  jobId       String
  job         RecruiterJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  email       String
  score       Int      @default(0) // AI match score 0-100
  stage       String   @default("new") // new, screening, interview, offer, hired, rejected
  notes       String   @default("")
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([jobId])
  @@index([stage])
  @@index([score])
}

// ===== HireNova Career — Career Roadmap & Skills Assessment =====

model CareerAssessment {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers     String   // JSON string of quiz answers
  targetRole  String   @default("")
  currentLevel String  @default("")
  roadmap     String?  // JSON string of generated roadmap
  skillsGap   String?  // JSON string of skills analysis
  score       Int?     // overall career readiness score 0-100
  language    String   @default("fr")
  createdAt   DateTime @default(now())

