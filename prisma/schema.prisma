// ===== Agent Bus — Inter-Agent Event System =====

model AgentEvent {
  id            String   @id @default(cuid())
  agentId       String                    // source agent (e.g. "cv", "ats", "linkedin")
  eventType     String                    // e.g. "cv_generated", "ats_scored", "linkedin_analyzed"
  payload       String   @default("{}")  // JSON payload with event details
  userId        String?                   // optional user context
  targetAgentId String?                   // if routed to a specific agent
  status        String   @default("processed") // processed | triggered | failed
  reactionLog   String?                   // JSON log of agent reactions triggered
  createdAt     DateTime @default(now())

  @@index([agentId])
  @@index([eventType])
  @@index([userId])
  @@index([targetAgentId])
  @@index([createdAt])
}

model AgentHeartbeat {
  id            String   @id @default(cuid())
  agentId       String                    // unique agent identifier
  agentName     String   @default("")    // display name
  category      String   @default("platform") // candidate | employment | platform
  status        String   @default("up")   // up | down | degraded
  endpoint      String?                   // HTTP endpoint for inter-agent triggers
  capabilities  String   @default("[]")  // JSON array of capability keys
  metadata      String   @default("{}")  // arbitrary JSON metadata
  lastHeartbeat DateTime @default(now())
  registeredAt  DateTime @default(now())

  @@unique([agentId])
  @@index([status])
  @@index([lastHeartbeat])
}

// ===== HNSA — AI Security Event =====
model AISecurityEvent {
  id              String   @id @default(cuid())
  userId          String?
  action          String   // ai_prompt_sent | ai_response_received | ai_abuse_blocked | ai_prompt_injection_detected | ai_data_leak_prevented
  severity        String   @default("info") // info | warning | critical
  inputHash       String?  // SHA-256 hash of input for deduplication (not storing raw prompts)
  inputLength     Int?
  outputLength    Int?
  model           String?  // gpt-4, claude, etc.
  tokensUsed      Int?
  blocked         Boolean  @default(false)
  blockReason     String?  // prompt_injection | pii_detected | rate_exceeded | content_policy
  ip              String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([inputHash])
}

// ===== SaaLabour — Software-as-Labour Mission System =====

model AgentMission {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("UserMissions", fields: [userId], references: [id])
  
  type          String   // cv_processing | candidate_sourcing | career_planning | interview_prep | marketing | job_analysis | linkedin_optimization | custom
  title         String
  description   String
  objective     String   // What the user wants achieved (natural language)
  parameters    String?  // JSON: mission-specific parameters
  
  // Agent chain configuration
  agentChain    String   // JSON array of agent steps: [{"agentId":"cv","action":"generate"},{"agentId":"ats","action":"analyze"}]
  
  // Status tracking
  status        String   @default("draft") // draft | queued | running | paused | completed | failed | cancelled
  priority      String   @default("normal") // low | normal | high | urgent
  
  // Progress
  totalSteps      Int      @default(0)
  completedSteps  Int      @default(0)
  progressPct     Int      @default(0)
  currentStep     Int      @default(0)
  
  // Timing
  startedAt       DateTime?
  completedAt     DateTime?
  deadlineAt      DateTime?
  estimatedMin    Int?
  
  // Results
  resultSummary   String?  // JSON: final results
  error           String?  // Error message if failed
  
  // SaaLabour Billing
  workUnits       Int      @default(0)  // Units of work completed
  costPerUnit     Int      @default(0)  // Cost per unit in cents
  totalCost       Int      @default(0)  // Total cost in cents
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  steps          MissionStep[]
}

model MissionStep {
  id          String        @id @default(cuid())
  missionId   String
  mission     AgentMission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  
  order       Int
  agentId     String   // References agent-registry IDs: cv, ats, recruiter, etc.
  agentName   String   // Human-readable agent name
  action      String   // What this step does
  input       String?  // JSON: input data
  
  status      String   @default("pending") // pending | running | completed | failed | skipped
  output      String?  // JSON: step result
  error       String?  // Error message if failed
  
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===== AI-OS — Agent Memory System =====

model AgentMemory {
  id          String   @id @default(cuid())
  agentId     String                     // source agent (e.g. "cv", "ats", "cto")
  category    String   @default("general") // general | business | user_preference | agent_experience | health
  key         String                     // memory key / topic
  value       String                     // JSON: memory content
  importance  Int      @default(5)       // 1-10 relevance score
  accessCount Int      @default(0)       // how often this memory is recalled
  userId      String?                    // optional user context
  expiresAt   DateTime?                  // optional TTL
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId])
  @@index([category])
  @@index([key])
  @@index([userId])
  @@index([importance])
  @@index([createdAt])
}

// ===== AI-OS — Agent Audit Log (immutable) =====

model AgentAuditLog {
  id          String   @id @default(cuid())
  agentId     String                     // agent that performed the action
  action      String                     // e.g. "decision_made", "task_completed", "memory_stored"
  target      String?                    // what was affected (userId, missionId, etc.)
  payload     String   @default("{}")   // JSON: action details
  riskLevel   String   @default("low")  // low | medium | high | critical
  userId      String?                    // optional user context
  ip          String?                    // optional IP for security actions
  createdAt   DateTime @default(now())

  @@index([agentId])
  @@index([action])
  @@index([riskLevel])
  @@index([userId])
  @@index([createdAt])
}

// ===== AI-OS — Agent Learning Log =====

model AgentLearningLog {
  id              String   @id @default(cuid())
  agentId         String                     // agent that learned
  outcomeType     String                     // success | failure | partial | escalated
  action          String                     // what was attempted
  context         String   @default("{}")   // JSON: situation context
  lesson          String                     // what was learned (natural language)
  improvementSugg String?                    // suggested improvement
  confidence      Int      @default(50)     // 0-100 confidence in this learning
  userId          String?                    // optional user context
  createdAt       DateTime @default(now())

  @@index([agentId])
  @@index([outcomeType])
  @@index([createdAt])
}

// ===== AI-OS — Agent Policy & Budget =====

model AgentPolicy {
  id              String   @id @default(cuid())
  agentId         String                     // agent this policy applies to
  policyType      String                     // permission | budget | rate_limit | data_access | tool_access
  policyKey       String                     // specific policy name
  policyValue     String                     // JSON: policy configuration
  isDefault       Boolean  @default(false)  // default policy for new agents
  description     String?                    // human-readable description
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([agentId, policyType, policyKey])
  @@index([agentId])
  @@index([policyType])
}

// ===== AI-OS — Tool Definitions (for Tool Gateway) =====

model ToolDefinition {
  id          String   @id @default(cuid())
  name        String                     // tool name (e.g. "web_search", "cv_generate", "email_send")
  category    String                     // search | generation | communication | analysis | payment
  description String                     // what this tool does
  parameters  String   @default("{}")   // JSON: expected parameters schema
  requiredPermit String  @default("auto") // auto | admin | owner — who can grant access
  isDangerous Boolean  @default(false)  // tools with side effects (payments, emails)
  isEnabled   Boolean  @default(true)   // can be disabled without removing
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name])
  @@index([category])
  @@index([isDangerous])
}

// ===== AI-OS — Proactive Suggestions =====

model ProactiveSuggestion {
  id          String   @id @default(cuid())
  userId      String                     // user this suggestion is for
  agentId     String                     // agent that generated this suggestion
  type        String                     // e.g. "cv_improvement", "job_match", "ats_optimization"
  title       String                     // short title
  description String                     // detailed description
  actionUrl   String?                    // URL to take action
  confidence  Int      @default(50)     // 0-100 confidence score
  priority    Int      @default(5)      // display priority (1=highest)
  category    String   @default("general") // general | urgent | promotional
  status      String   @default("active") // active | dismissed | acted_upon | expired
  dismissedAt DateTime?                  // when user dismissed it
  actedAt     DateTime?                  // when user acted on it
  expiresAt   DateTime?                  // optional expiration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([agentId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ===== AI-OS — Agent Task Queue (inter-agent communication) =====

model AgentTask {
  id           String   @id @default(cuid())
  fromAgentId  String                     // sending agent
  toAgentId    String                     // receiving agent
  missionId    String?                    // optional parent mission
  type         String                     // delegate | inform | request | respond
  payload      String   @default("{}")   // JSON: task data
  priority     Int      @default(5)      // 1=urgent, 10=low
  status       String   @default("pending") // pending | in_progress | completed | failed | cancelled
  result       String?                    // JSON: task result
  error        String?                    // error message if failed
  userId       String?                    // optional user context
  dueAt        DateTime?                  // optional deadline
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([fromAgentId])
  @@index([toAgentId])
  @@index([missionId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

// ===== Payment Abstraction Layer — Unified Checkout Records =====

model UnifiedPayment {
  id                     String   @id @default(cuid())
  checkoutId             String   @unique  // public-facing checkout ID
  userId                 String
  planId                 String   // starter | pro | career_plus | employer | enterprise | annual | api
  amount                 Int      // in cents (smallest currency unit)
  currency               String   @default("EUR")  // ISO 4217
  country                String?  // ISO 3166-1 alpha-2
  paymentMethod          String?  // card | mobile | bank_transfer
  email                  String?
  status                 String   @default("pending")  // pending | requires_action | processing | succeeded | failed | cancelled | refunded
  provider               String   // stripe | paymob | lemonsqueezy | invoice | dev_simulator
  providerTransactionId  String?  // external ID from the payment provider
  region                 String   @default("international")  // international | morocco | africa | enterprise
  routingReason          String?  // why this provider was chosen
  redirectUrl            String?  // checkout redirect URL
  clientSecret           String?  // for client-side confirmation
  successUrl             String?
  cancelUrl              String?
  metadata               String?  // JSON: additional context
  paidAt                 DateTime?
  refundedAt             DateTime?
  refundedAmount         Int      @default(0)  // in cents
  idempotencyKey         String   @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId])
  @@index([provider])
  @@index([region])
  @@index([status])
  @@index([planId])
  @@index([checkoutId])
  @@index([providerTransactionId])
  @@index([idempotencyKey])
  @@index([createdAt])
}

// ===== BazNova Early Access — 50 Beta-Testeurs =====

model EarlyAccessSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  language  String   @default("fr")
  persona   String?  // student | graduate | professional | executive
  source    String?  // landing | referral | direct
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

// ===== BazNova Beta Feedback =====

model BetaFeedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  category  String   // bug | feature | general | ux
  message   String
  rating    Int?     // 1-5
  page      String?  // which page the feedback was given from
  status    String   @default("new") // new | reviewed | resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}
