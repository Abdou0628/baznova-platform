// ===== HNSA — Immutable Audit Log =====
model SecurityAudit {
  id          String   @id @default(cuid())
  actorId     String?  // User ID who performed the action (null for system/anonymous)
  actorEmail  String?
  actorRole   String?  // candidate | employer | admin | system
  action      String   // LOGIN_SUCCESS | LOGIN_FAILURE | CV_CREATED | CV_DELETED | PAYMENT_INITIATED | ADMIN_USER_MODIFIED | etc.
  resource    String   // user | resume | cover_letter | payment | job_listing | subscription | admin_config | etc.
  resourceId  String?  // ID of the affected resource
  outcome     String   @default("success") // success | failure | denied | error
  ip          String   @default("unknown")
  userAgent   String?
  path        String?
  method      String?
  statusCode  Int?
  details     String?  // JSON blob with extra context
  sessionId   String?  // For session correlation
  createdAt   DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@index([actorEmail])
}

