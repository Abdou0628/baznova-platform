                { q: 'faqQ4' as const, a: 'faqA4' as const },
                { q: 'faqQ5' as const, a: 'faqA5' as const },
                { q: 'faqQ6' as const, a: 'faqA6' as const },
                { q: 'faqQ7' as const, a: 'faqA7' as const },
